# --- MCP server transport ---
# streamable-http (default, 2026-07-28 spec) | stdio | sse
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp

# --- Web admin ---
# Light single-page admin at /admin. Set false to disable entirely.
WEB_ENABLED=true
# Token required for remote access. Empty = localhost can access without token.
ADMIN_TOKEN=

# --- Default vision backend ---
# Leave commented to let the admin UI / config.toml control the default provider.
# Uncomment and set to lock it (env overrides config.toml on restart).
# DEFAULT_PROVIDER=default

# --- Provider API keys (referenced via ${ENV} in config.toml) ---
# Example: your LiteLLM gateway / vLLM endpoint
DEPU_GATEWAY_API_KEY=sk-your-api-key-here
# Other providers (uncomment as needed)
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=

# --- Override base system prompt (optional) ---
# BASE_VISION_PROMPT=
